# ===== Python =====
__pycache__/
*.pyc
*.pyo
*.pyd

# ===== Virtual env =====
.venv/
venv/

# ===== Python packaging / build artifacts =====
build/
dist/
*.egg
*.egg-info/
pip-wheel-metadata/
*.whl

# ===== Tool caches =====
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ===== HuggingFace / Model cache =====
_hf_cache/
.cache/
*.bin
*.pt
*.safetensors

# ===== Data (keep structure, ignore contents) =====
data/raw/**
data/interim/**
data/outputs/**
data/processed/**

# keep input configs / samples
!data/input/**
!data/processed/sample_*.csv
!data/sample/**

# ===== Artifacts / Outputs =====
outputs/**
artifacts/**

# ===== Vector / numeric artifacts =====
*.npy
*.npz
*.faiss
*.index

# ---- allow small reproducible samples even if extension is ignored above ----
!data/sample/**/faiss.index
!data/sample/**/meta.jsonl
!data/sample/**/merge_log.csv

# ===== Logs & temp =====
*.log
_tmp/
temp/

# ===== OS =====
.DS_Store
Thumbs.db

# ===== IDE =====
.vscode/
.idea/

# ===== Secrets =====
.env

# (Optional) if you DON'T want to commit final metrics output, uncomment:
# metrics_*.csv
